# Linux Panel Nginx HTTPS vhost template. Substituted by scripts/install.sh.
# Use your own vhost location when running an existing Nginx control panel.
server {
    listen 80;
    server_name __DOMAIN__;
    return 301 https://__DOMAIN__$request_uri;
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;
    limit_req_status 429;
    server_tokens off;

    # Chunked file transfer only. 1 MiB chunks fit in 2m; other routes stay at 32k.
    location /api/files/ {
        client_max_body_size 2m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:4188;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:4188;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }
    location = /api/auth/login {
        limit_req zone=lp_login burst=5 nodelay;
        include /etc/nginx/snippets/linux-panel-proxy.inc;
    }
    location = /oauth/register {
        limit_req zone=lp_oauth_register burst=3 nodelay;
        include /etc/nginx/snippets/linux-panel-proxy.inc;
    }
    location = /oauth/token {
        limit_req zone=lp_oauth_token burst=10 nodelay;
        include /etc/nginx/snippets/linux-panel-proxy.inc;
    }
}

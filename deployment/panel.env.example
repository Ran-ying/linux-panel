# Owned by root, mode 0600. Linux Panel-only; no reverse-proxy settings.
# Loopback is the default. Wildcard requires operator-managed external HTTPS.
PANEL_LISTEN_HOST=127.0.0.1
PANEL_LISTEN_PORT=4188
PANEL_DATA_DIR=/var/lib/linux-panel
# Optional; for external reverse proxies: exact HTTPS browser-facing origin.
# When omitted, loopback defaults to http://127.0.0.1:PANEL_LISTEN_PORT.
# PANEL_PUBLIC_ORIGIN=https://panel.example.com

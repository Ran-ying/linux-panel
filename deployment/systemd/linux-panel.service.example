# Linux Panel dedicated non-root service (copy and adjust before using).
# Requires an existing linuxpanel system user, /opt/linux-panel checkout
# readable by it, and /var/lib/linux-panel writable only by it.
# Requires a supported OS and Node.js 22.12+ or 24 installed at /usr/bin/node.
[Unit]
Description=Linux Panel (private public preview)
After=network.target

[Service]
Type=simple
User=linuxpanel
Group=linuxpanel
WorkingDirectory=/opt/linux-panel
Environment=NODE_ENV=production
Environment=PORT=4188
EnvironmentFile=/etc/linux-panel/panel.env
ExecStart=/usr/bin/node apps/api/src/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/linux-panel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Recover interrupted Linux Panel Broker transaction before Web boot
After=network-online.target
Wants=network-online.target
# Deliberately no Before=linux-panel.service ordering: a synchronous Web
# startup and health probe inside this oneshot would otherwise deadlock.
# The Web startup guard rejects boot before recovery unless this live root
# worker issues its ephemeral permit after restoring the state.

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/linux-panel-update-worker --recover-only
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/linux-panel /var/lib/linux-panel /var/lib/linux-panel-updater /var/lib/linux-panel-update-root /var/lib/linux-panel-update-status
RuntimeDirectory=linux-panel-root-updater
RuntimeDirectoryMode=0700
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
# Preserve only the two identity-drop caps across the root shell/exec chain;
# ordinary updater Git/npm children drop all capabilities via setpriv.
AmbientCapabilities=CAP_SETUID CAP_SETGID
RestrictSUIDSGID=true
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target

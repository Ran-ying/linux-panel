[Unit]
Description=Execute one approved Linux Panel Git update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/linux-panel-update-worker
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/linux-panel /var/lib/linux-panel /var/lib/linux-panel-updater /var/lib/linux-panel-update-root
RuntimeDirectory=linux-panel-root-updater
RuntimeDirectoryMode=0700
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
RestrictSUIDSGID=true
TimeoutStartSec=900

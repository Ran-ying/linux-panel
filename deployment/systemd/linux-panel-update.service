[Unit]
Description=Execute one approved Linux Panel Git update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=/opt/linux-panel/runtime:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/libexec/linux-panel-update-worker
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/linux-panel /var/lib/linux-panel /var/lib/linux-panel-updater
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
RestrictSUIDSGID=true
TimeoutStartSec=900

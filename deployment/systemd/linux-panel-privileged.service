[Unit]
Description=Linux Panel reviewed privileged Actions
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=linux-panel-privileged
RuntimeDirectoryMode=0750
Environment=NODE_OPTIONS=
Environment=NODE_PATH=
ExecStart=/opt/node24/bin/node /usr/local/lib/linux-panel-privileged/current/server.js
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
ProtectSystem=false
ProtectHome=false
PrivateTmp=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN CAP_FSETID CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
